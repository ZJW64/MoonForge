// 代码生成：把类型模型交给规则，组装成一份可直接被 `moon check` 编译的 MoonBit 源文件。
//
// 幂等性是硬要求：同样的输入必须产出**逐字节相同**的输出，
// 这样生成物才能进版本库、才能被 `moonforge check` 在 CI 里做漂移检查。
// 因此生成文件头里的 `source` 只写**文件名**而不是绝对路径，避免跨机器不一致。

///|
pub const MOONFORGE_VERSION : String = "0.3.0"

///|
/// 把 CRLF / 单独的 CR 统一成 LF。
///
/// 为什么这是正确性问题而不是洁癖：生成物是提交进版本库的，而 Windows 上
/// `core.autocrlf=true`（Git for Windows 的默认值）会在检出时把文本文件换成
/// CRLF。此时磁盘上的生成物是 CRLF、生成器产出的是 LF，`check` 会把它判成
/// "内容过期" —— 用户按提示跑 `gen`，写回的是 LF 文件，Git 下次检出又换成
/// CRLF，漂移永远修不掉。这个坑在"生成物进仓库"的设计下是必然会踩到的，
/// 所以比较与解析前一律先归一化。
///
/// 生成侧**只产出 LF**：归一化只作用于"读进来的字节"。
pub fn normalize_newlines(s : String) -> String {
  // 快路径：绝大多数文件里没有 CR，直接原样返回，避免无谓拷贝。
  let n = s.length()
  let mut i = 0
  let mut has_cr = false
  while i < n {
    if s.at(i) == 13 {
      has_cr = true
      break
    }
    i = i + 1
  }
  if !has_cr {
    return s
  }
  let b = StringBuilder()
  let mut j = 0
  while j < n {
    let c = s.at(j)
    if c == 13 {
      b.write_string("\n")
      // CRLF 里的 LF 一并吃掉：CRLF 与单独出现的 CR 都归一成 LF。
      if j + 1 < n && s.at(j + 1) == 10 {
        j = j + 1
      }
    } else {
      b.write_stringview(s[j:j + 1])
    }
    j = j + 1
  }
  b.to_string()
}

///|
/// 生成物里最长的那些行（`impl` 头）允许的列数上限。
///
/// 82 是**实测**出来的边界，不是"约等于 80"的估计：`moonfmt` 对 82 列及以下的
/// `impl` 头原样保留，83 列起就把返回类型或参数表折行。实测命令见
/// `scripts/fmt_budget_probe.sh`（它把这条边界钉住，免得以后换工具链时悄悄失效）。
///
/// 为什么要在意：生成物是提交进仓库的，用户迟早会跑 `moon fmt`。一旦
/// 生成器的字节输出与格式化器不同，`check` 就永久报漂移，而且 `gen` 也修不好
/// （它照旧写单行版）。所以这里把它当成一条硬约束来守，超了就在生成阶段说清楚。
pub const FMT_WIDTH_BUDGET : Int = 82

///|
/// 生成结果。
pub(all) struct GenOutcome {
  /// 生成的文件内容；`has_output` 为 false 时是空串。
  text : String
  /// 实际生成的内容清单，形如 `["User.validate", "User.diff"]`。
  applied : Array[String]
  /// 诊断信息：未知规则名、规则不适用等。不阻断生成，但对使用者可见。
  diagnostics : Array[String]
  /// 是否产出了内容。false 表示这个源文件里没有任何派生标记（`impl` 声明）。
  has_output : Bool
}

///|
fn gen_header(
  source_name : String,
  used : Array[String],
  version : String,
) -> String {
  let sep = "// ---------------------------------------------------------------------------\n"
  let b = StringBuilder()
  b.write_string(sep)
  b.write_string("// Generated by MoonForge " + version + " -- DO NOT EDIT.\n")
  b.write_string("// source : " + source_name + "\n")
  b.write_string("// rules  : " + used.join(", ") + "\n")
  // 打开生成物的人最需要的上下文是「源文件里长什么样才会有这一行」，
  // 所以把入口形状写在这里，省得回翻文档。
  b.write_string(
    "// entry  : impl @derive.DeriveXxx for <Type> with fn requested(_self) {}\n",
  )
  b.write_string("// regen  : moon run cmd/main -- gen <dir>\n")
  b.write_string(sep)
  b.write_string("\n")
  b.to_string()
}

///|
fn find_type(types : Array[TypeDef], name : String) -> TypeDef? {
  for t in types {
    if t.name == name {
      return Some(t)
    }
  }
  None
}

///|
fn push_unique(a : Array[String], s : String) -> Unit {
  let mut exists = false
  for x in a {
    if x == s {
      exists = true
    }
  }
  if !exists {
    a.push(s)
  }
}

///|
fn contains(a : Array[String], s : String) -> Bool {
  let mut found = false
  for x in a {
    if x == s {
      found = true
    }
  }
  found
}

///|
/// 取第一行（不含行尾换行）。
fn first_line(s : String) -> String {
  match s.find("\n") {
    Some(i) => s[0:i].to_owned()
    None => s
  }
}

///|
/// 生成物的 `impl` 头：`pub impl <前缀>.<Trait> for <类型> with fn <方法签名> {`。
///
/// 单独抽成函数，是为了让列宽守卫（`FMT_WIDTH_BUDGET`）能直接量这一行，
/// 而不必从渲染结果里反推 —— 反推的代码本身又是一处要维护的约定。
///
/// 目标 trait 的路径**复用用户写标记时用的包前缀**（`@derive` / `@d` / 空），
/// 因此用户给包起什么别名都不必迁就工具；生成物与手写标记只见一处约定。
fn impl_head_line(
  decl : ImplDecl,
  rule : &DeriveRule,
  td : TypeDef,
  method_head : String,
) -> String {
  let b = StringBuilder()
  // `pub`：把这段实现标记为包对外 API 的一部分。它同时消掉 `unused_value`
  // （"Unused trait implementation"）—— 默认可见性的 impl 在本包内没被调用
  // 就会被警告，而派生出来的实现本来就是给外部用的。
  b.write_string("pub impl ")
  if decl.prefix.length() > 0 {
    b.write_string(decl.prefix + ".")
  }
  b.write_string(trait_name_of(rule))
  b.write_string(" for ")
  b.write_string(td.name)
  b.write_string(" with ")
  b.write_string(method_head)
  b.to_string()
}

///|
/// 把一条派生请求渲染成一段完整的 `impl`。
///
/// 第一行的列宽是硬约束（见 `FMT_WIDTH_BUDGET`），成员体由规则给出，
/// 且**不重复声明返回类型** —— 理由见 `Fragment::impl_body` 的契约说明。
fn render_impl(
  decl : ImplDecl,
  rule : &DeriveRule,
  td : TypeDef,
  frag : Fragment,
) -> String {
  let b = StringBuilder()
  if frag.notes.length() > 0 {
    for n in frag.notes {
      b.write_string(n)
    }
    // 空行：`moon fmt` 要求独立注释块与其后的 item 之间留空行，
    // 否则格式化一次就与生成结果永久不一致。
    b.write_string("\n")
  }
  b.write_string("///|\n")
  // 成员体的第一行（含 `{`）由 `impl_head_line` 负责拼进 impl 头，
  // 这里接上**剩下的部分**。注意余下部分自带行首换行，所以中间不再补 `\n`；
  // 补了就会多出一个空行，而空行正是 `moon fmt` 会抹掉的东西。
  let method_head = first_line(frag.impl_body)
  b.write_string(impl_head_line(decl, rule, td, method_head))
  if method_head.length() < frag.impl_body.length() {
    b.write_string(frag.impl_body[method_head.length():].to_owned())
  }
  b.to_string()
}

///|
/// 遇到不认识的标记 trait 时，说清楚两件事：可用的是哪些、以及最常见的误写。
fn unknown_marker_message(
  rules : Array[&DeriveRule],
  marker : String,
  line : Int,
) -> String {
  let available = marker_names(rules).join(", ")
  let b = StringBuilder()
  b.write_string("第 \{line} 行：未知的标记 trait `" + marker + "`。")
  b.write_string("已注册的标记 trait：")
  if available.length() > 0 {
    b.write_string(available)
  } else {
    b.write_string("（无）")
  }
  // 从注释写法迁移过来的用户最容易把「规则键」当成标记名写进 impl，
  // 这里直接点破，省掉一轮猜测。
  match find_rule(rules, marker) {
    Some(r) =>
      b.write_string(
        "。注意你写的是**规则键**；派生入口是标记 trait，应为 `" +
        marker_of(r) +
        "`",
      )
    None => b.write_string("。可用 `list-rules` 查看全部规则")
  }
  b.to_string()
}

///|
/// `impl` 头超出行宽预算时的提示（见 `FMT_WIDTH_BUDGET`）。
///
/// 这条诊断**不阻断生成**：代码照旧产出，因为"类型名太长"不是用户的错误，
/// 更不该让工具拒绝干活。但不说不行的理由是：`moon fmt` 会把这行折开，
/// 于是生成物与格式化结果不一致、`check` 报漂移，而 `gen` 修不好它
/// （它照旧写单行版）。与其让用户在"fmt 与 check 之间反复横跳"，不如在这里
/// 把原因和可操作的三条出路一次讲清。
fn width_budget_message(
  decl : ImplDecl,
  rule : &DeriveRule,
  td : TypeDef,
  head_line : String,
) -> String {
  "第 \{decl.line} 行：为 `" +
  td.name +
  "` 生成的 impl 头有 " +
  head_line.length().to_string() +
  " 列，超过 `moon fmt` 的列宽预算（" +
  FMT_WIDTH_BUDGET.to_string() +
  " 列）。`moon fmt` 会把这行折开，生成物就与格式化结果不一致、`check` 会报漂移。" +
  "三条出路：缩短类型名；给 `" +
  trait_name_of(rule) +
  "` 所在的包起更短的别名（生成的 impl 复用你写标记时的前缀 `" +
  decl.prefix +
  "`）；或让该规则的成员签名更短。"
}

///|
/// 老写法（doc comment 里的 `@derive(...)`）的迁移提示。
///
/// 直接给出可粘贴的新代码，而不是只说一句「已废弃」—— 升级时最需要的是
/// 「那我现在该写什么」。
fn legacy_derive_message(
  td : TypeDef,
  legacy : Array[String],
  rules : Array[&DeriveRule],
  prefix_hint : String,
) -> String {
  let b = StringBuilder()
  b.write_string(
    "第 \{td.line} 行：" +
    td.name +
    " 仍在使用已废弃的 doc comment 写法 `@derive(" +
    legacy.join(", ") +
    ")`，该写法不再产生任何代码。请改写为真实的 trait impl 标记：",
  )
  for k in legacy {
    match find_rule(rules, k) {
      Some(r) =>
        b.write_string(
          "\n    pub impl " +
          prefix_hint +
          "." +
          marker_of(r) +
          " for " +
          td.name +
          " with fn requested(_self) {}",
        )
      None =>
        b.write_string(
          "\n    （规则 `" +
          k +
          "` 未注册，先 `list-rules` 看可用规则）",
        )
    }
  }
  b.to_string()
}

///|
/// 规则返回 `None` 时，用**可验证的事实**解释"为什么不适用"。
///
/// 三种原因分开写，而不是笼统地回一句"不支持"：用户需要一眼看出到底是
/// "规则选错了"还是"这个类型本来就没有具名字段"。后者是硬限制（位置参数
/// 结构体没有名字可展开），不是工具没做好 —— 说清楚比含糊过去更重要。
pub fn not_applicable_reason(td : TypeDef) -> String {
  match td.kind {
    TEnum => "该规则只支持 struct 定义"
    TStruct =>
      match td.body {
        Positional =>
          td.name + " 是位置参数（元组）结构体，没有具名字段"
        Missing =>
          td.name +
          " 的声明里没有找到字段体（既没有 `(` 也没有 `{`）"
        // Record 时规则不该返回 None；这里保留兜底文案，避免新增规则时
        // 出现半句话的诊断。
        _ => "该规则不适用于 " + td.name
      }
  }
}

///|
/// 对一份源码执行全部被请求的派生规则，返回可直接落盘的文本。
///
/// 顺序约定：按 `impl` 标记在源码中出现的顺序输出，因此输出与书写顺序
/// 一一对应，便于人工核对。
pub fn generate(
  source_name : String,
  src : String,
  rules : Array[&DeriveRule],
  version : String,
) -> GenOutcome {
  let parsed = parse(src)
  let chunks : Array[String] = []
  let applied : Array[String] = []
  let diagnostics : Array[String] = []
  let used : Array[String] = []
  // 同一 (类型, 标记) 只生成一次：重复的标记若照搬进生成物，会得到两个
  // 完全相同的 impl，编译期直接报重复实现 —— 那是个本可以在生成阶段
  // 说清楚的错误。
  let seen : Array[String] = []
  for decl in parsed.impls {
    match find_type(parsed.types, decl.target) {
      None =>
        diagnostics.push(
          "第 \{decl.line} 行：`impl " +
          decl.marker +
          " for " +
          decl.target +
          "` 中的类型 " +
          decl.target +
          " 在本文件里没有 struct / enum 定义" +
          "（moonforge 只在同一文件内建立对应关系；跨文件请把标记写到类型所在文件）",
        )
      Some(td) => {
        let pair = decl.target + "#" + decl.marker
        if contains(seen, pair) {
          diagnostics.push(
            "第 \{decl.line} 行：重复的派生声明 `" +
            decl.marker +
            " for " +
            decl.target +
            "`，已忽略（保留首次声明；重复会在生成物里造成重复 impl）",
          )
        } else {
          seen.push(pair)
          match find_rule_by_marker(rules, decl.marker) {
            None =>
              diagnostics.push(
                unknown_marker_message(rules, decl.marker, decl.line),
              )
            Some(r) =>
              match r.generate(td) {
                None =>
                  diagnostics.push(
                    "规则 `" +
                    key_of(r) +
                    "` 不适用于 " +
                    td.name +
                    "（第 \{decl.line} 行）：" +
                    not_applicable_reason(td),
                  )
                Some(frag) => {
                  // 先量一次 impl 头：超预算时给出可操作的诊断（见
                  // `width_budget_message`）。放在产出之前，是为了让"这行
                  // 会被 fmt 折开"这件事在生成阶段就说出来，而不是等用户
                  // 跑完 fmt 发现 check 红了再回头猜。
                  let head_line = impl_head_line(
                    decl,
                    r,
                    td,
                    first_line(frag.impl_body),
                  )
                  if head_line.length() > FMT_WIDTH_BUDGET {
                    diagnostics.push(
                      width_budget_message(decl, r, td, head_line),
                    )
                  }
                  chunks.push(render_impl(decl, r, td, frag))
                  applied.push(td.name + "." + key_of(r))
                  push_unique(used, key_of(r))
                }
              }
          }
        }
      }
    }
  }
  // 迁移提示：老写法不再生效，必须让用户看见，否则生成物会"莫名消失"。
  let mut prefix_hint = "@derive"
  for d in parsed.impls {
    if d.prefix.length() > 0 {
      prefix_hint = d.prefix
    }
  }
  for td in parsed.types {
    let legacy = td.legacy_derive_rules()
    if legacy.length() > 0 {
      diagnostics.push(legacy_derive_message(td, legacy, rules, prefix_hint))
    }
  }
  if chunks.length() == 0 {
    return { text: "", applied, diagnostics, has_output: false, }
  }
  let buf = StringBuilder()
  buf.write_string(gen_header(source_name, used, version))
  let mut first = true
  for c in chunks {
    if !first {
      buf.write_string("\n")
    }
    buf.write_string(c)
    first = false
  }
  { text: buf.to_string(), applied, diagnostics, has_output: true, }
}

///|
/// 由源文件名推出生成文件名：`models.mbt` → `models_derive_gen.mbt`。
pub fn generated_file_name(source_file : String) -> String {
  let stem = if source_file.has_suffix(".mbt") {
    source_file[0:source_file.length() - 4].to_owned()
  } else {
    source_file
  }
  stem + "_derive_gen.mbt"
}

///|
/// 是否是本工具产出的文件（用于在目录扫描时跳过自己，避免自我循环）。
pub fn is_generated_file(name : String) -> Bool {
  name.has_suffix("_derive_gen.mbt")
}

///|
/// 是否是需要处理的 MoonBit 源文件。
pub fn is_source_file(name : String) -> Bool {
  name.has_suffix(".mbt") && !is_generated_file(name)
}
