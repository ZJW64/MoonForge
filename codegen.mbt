// 代码生成：把类型模型交给规则，组装成一份可直接被 `moon check` 编译的 MoonBit 源文件。
//
// 幂等性是硬要求：同样的输入必须产出**逐字节相同**的输出，
// 这样生成物才能进版本库、才能被 `moonforge check` 在 CI 里做漂移检查。
// 因此生成文件头里的 `source` 只写**文件名**而不是绝对路径，避免跨机器不一致。

///|
pub const MOONFORGE_VERSION : String = "0.1.0"

///|
/// 把 CRLF / 单独的 CR 统一成 LF。
///
/// 为什么这是正确性问题而不是洁癖：生成物是提交进版本库的，而 Windows 上
/// `core.autocrlf=true`（Git for Windows 的默认值）会在检出时把文本文件换成
/// CRLF。此时磁盘上的生成物是 CRLF、生成器产出的是 LF，`check` 会把它判成
/// "内容过期" —— 用户按提示跑 `gen`，写回的是 LF 文件，Git 下次检出又换成
/// CRLF，漂移永远修不掉。这个坑在"生成物进仓库"的设计下是必然会踩到的，
/// 所以比较与解析前一律先归一化。
///
/// 生成侧**只产出 LF**：归一化只作用于"读进来的字节"。
pub fn normalize_newlines(s : String) -> String {
  // 快路径：绝大多数文件里没有 CR，直接原样返回，避免无谓拷贝。
  let n = s.length()
  let mut i = 0
  let mut has_cr = false
  while i < n {
    if s.at(i) == 13 {
      has_cr = true
      break
    }
    i = i + 1
  }
  if !has_cr {
    return s
  }
  let b = StringBuilder()
  let mut j = 0
  while j < n {
    let c = s.at(j)
    if c == 13 {
      b.write_string("\n")
      // CRLF 里的 LF 一并吃掉：CRLF 与单独出现的 CR 都归一成 LF。
      if j + 1 < n && s.at(j + 1) == 10 {
        j = j + 1
      }
    } else {
      b.write_stringview(s[j:j + 1])
    }
    j = j + 1
  }
  b.to_string()
}

///|
/// 生成结果。
pub(all) struct GenOutcome {
  /// 生成的文件内容；`has_output` 为 false 时是空串。
  text : String
  /// 实际生成的内容清单，形如 `["User.validate", "User.diff"]`。
  applied : Array[String]
  /// 诊断信息：未知规则名、规则不适用等。不阻断生成，但对使用者可见。
  diagnostics : Array[String]
  /// 是否产出了内容。false 表示这个源文件里没有任何 `@derive` 标记。
  has_output : Bool
}

///|
/// 把规则的“跳过说明行”与规则正文拼成一个代码片段。
///
/// 说明行是普通的 `// moonforge: ...` 注释，且与正文之间必须留一个空行 ——
/// 这是 `moon fmt` 对“独立注释块 + 紧随其后的 `///|`”的要求。
///
/// 为什么这是硬约束而不是风格偏好：生成物是**提交进仓库**的，用户迟早会跑
/// `moon fmt`。如果生成器产出的字节与 `moon fmt` 的结果不同，格式化一次之后
/// `check` 就会永远报漂移，而且再跑 `gen` 也修不好 —— 用户被卡在一个没有出口的
/// 循环里。所以“生成物在 `moon fmt` 下稳定”属于正确性问题，由 `e2e.sh` 与 CI
/// 的“先 fmt 再 check”阶段守住。
pub fn with_notes(notes : Array[String], body : String) -> String {
  if notes.length() == 0 {
    return body
  }
  let b = StringBuilder()
  for n in notes {
    b.write_string(n)
  }
  b.write_string("\n")
  b.write_string(body)
  b.to_string()
}

///|
fn gen_header(
  source_name : String,
  used : Array[String],
  version : String,
) -> String {
  let sep = "// ---------------------------------------------------------------------------\n"
  let b = StringBuilder()
  b.write_string(sep)
  b.write_string("// Generated by MoonForge " + version + " -- DO NOT EDIT.\n")
  b.write_string("// source : " + source_name + "\n")
  b.write_string("// rules  : " + used.join(", ") + "\n")
  b.write_string("// regen  : moon run cmd/main -- gen <dir>\n")
  b.write_string(sep)
  b.write_string("\n")
  b.to_string()
}

///|
/// 规则返回 `None` 时，用**可验证的事实**解释"为什么不适用"。
///
/// 三种原因分开写，而不是笼统地回一句"不支持"：用户需要一眼看出到底是
/// "规则选错了"还是"这个类型本来就没有具名字段"。后者是硬限制（位置参数
/// 结构体没有名字可展开），不是工具没做好 —— 说清楚比含糊过去更重要。
pub fn not_applicable_reason(td : TypeDef) -> String {
  match td.kind {
    TEnum => "该规则只支持 struct 定义"
    TStruct =>
      match td.body {
        Positional =>
          td.name + " 是位置参数（元组）结构体，没有具名字段"
        Missing =>
          td.name +
          " 的声明里没有找到字段体（既没有 `(` 也没有 `{`）"
        // Record 时规则不该返回 None；这里保留兜底文案，避免新增规则时
        // 出现半句话的诊断。
        _ => "该规则不适用于 " + td.name
      }
  }
}

///|
/// 对一份源码执行全部请求的派生规则，返回可直接落盘的文本。
///
/// 顺序约定：按类型在源码中出现的顺序、按 `@derive(...)` 里书写的规则顺序输出，
/// 因此输出与“书写顺序”一一对应，便于人工核对。
pub fn generate(
  source_name : String,
  src : String,
  rules : Array[Rule],
  version : String,
) -> GenOutcome {
  let types = parse_source(src)
  let chunks : Array[String] = []
  let applied : Array[String] = []
  let diagnostics : Array[String] = []
  let used : Array[String] = []
  for td in types {
    let wanted = td.derive_rules()
    if wanted.length() == 0 {
      continue
    }
    for rn in wanted {
      match find_rule(rules, rn) {
        None =>
          match invalid_rule_name_reason(rn) {
            Some(why) =>
              diagnostics.push(
                why + "（由 \{td.name} 在第 \{td.line} 行请求）",
              )
            None =>
              diagnostics.push(
                "未知规则 `" +
                rn +
                "`（由 \{td.name} 在第 \{td.line} 行请求）；可用 `moonforge list-rules` 查看",
              )
          }
        Some(r) =>
          match r.apply(td) {
            None =>
              diagnostics.push(
                "规则 `" +
                rn +
                "` 不适用于 \{td.name}（第 \{td.line} 行）：" +
                not_applicable_reason(td),
              )
            Some(code) => {
              chunks.push(code)
              applied.push(td.name + "." + rn)
              let mut exists = false
              for u in used {
                if u == rn {
                  exists = true
                }
              }
              if !exists {
                used.push(rn)
              }
            }
          }
      }
    }
  }
  if chunks.length() == 0 {
    return { text: "", applied, diagnostics, has_output: false, }
  }
  let buf = StringBuilder()
  buf.write_string(gen_header(source_name, used, version))
  let mut first = true
  for c in chunks {
    if !first {
      buf.write_string("\n")
    }
    buf.write_string(c)
    first = false
  }
  { text: buf.to_string(), applied, diagnostics, has_output: true, }
}

///|
/// 由源文件名推出生成文件名：`models.mbt` → `models_derive_gen.mbt`。
pub fn generated_file_name(source_file : String) -> String {
  let stem = if source_file.has_suffix(".mbt") {
    source_file[0:source_file.length() - 4].to_owned()
  } else {
    source_file
  }
  stem + "_derive_gen.mbt"
}

///|
/// 是否是本工具产出的文件（用于在目录扫描时跳过自己，避免自我循环）。
pub fn is_generated_file(name : String) -> Bool {
  name.has_suffix("_derive_gen.mbt")
}

///|
/// 是否是需要处理的 MoonBit 源文件。
pub fn is_source_file(name : String) -> Bool {
  name.has_suffix(".mbt") && !is_generated_file(name)
}
