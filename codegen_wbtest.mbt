// L3/L4/L5 测试：代码生成。
//
// L4（金样）：固定输入 → 断言输出**逐字节**等于预期文本。
// L5（幂等）：同一输入连续生成两次，结果必须完全相同。
// L3（规则分派）：未知规则、规则不适用两条错误路径。

///|
fn dummy_rule() -> Rule {
  {
    name: "dummy",
    description: "测试用规则",
    gen: fn(td : TypeDef) -> String? {
      if td.is_enum() {
        return None
      }
      Some("///|\npub fn " + td.name + "::dummy() -> Unit {\n  ()\n}\n")
    },
  }
}

///|
fn rules_of(rs : Array[Rule]) -> Array[Rule] {
  rs
}

///|
test "生成：没有 @derive 标记时不产出内容（零侵入）" {
  let src =
    #|struct A { x : Int }
    #|fn f() -> Unit { () }
  let out = generate("a.mbt", src, [dummy_rule()], "0.0.0-test")
  @debug.debug_inspect(out.has_output, content=(
    #|false
  ))
  @debug.debug_inspect(out.text, content=(
    #|""
  ))
  @debug.debug_inspect(out.applied.length(), content=(
    #|0
  ))
  @debug.debug_inspect(out.diagnostics.length(), content=(
    #|0
  ))
}

///|
test "生成金样：文件头 + 按书写顺序拼接规则输出" {
  let src =
    #|/// @derive(beta, alpha)
    #|struct A { x : Int }
  let beta : Rule = {
    name: "beta",
    description: "",
    gen: fn(_td : TypeDef) -> String? { Some("///|\n// beta\n") },
  }
  let alpha : Rule = {
    name: "alpha",
    description: "",
    gen: fn(_td : TypeDef) -> String? { Some("///|\n// alpha\n") },
  }
  let out = generate("a.mbt", src, [alpha, beta], "0.0.0-test")
  @debug.debug_inspect(out.text, content=(
    #|"// ---------------------------------------------------------------------------\n// Generated by MoonForge 0.0.0-test -- DO NOT EDIT.\n// source : a.mbt\n// rules  : beta, alpha\n// regen  : moon run cmd/main -- gen <dir>\n// ---------------------------------------------------------------------------\n\n///|\n// beta\n\n///|\n// alpha\n"
  ))
  @debug.debug_inspect(out.applied, content=(
    #|["A.beta", "A.alpha"]
  ))
}

///|
test "生成金样：两个类型、跨行输出" {
  let src =
    #|/// @derive(dummy)
    #|struct A { x : Int }
    #|
    #|/// @derive(dummy)
    #|struct B { y : String }
  let out = generate("m.mbt", src, [dummy_rule()], "0.0.0-test")
  @debug.debug_inspect(out.text, content=(
    #|"// ---------------------------------------------------------------------------\n// Generated by MoonForge 0.0.0-test -- DO NOT EDIT.\n// source : m.mbt\n// rules  : dummy\n// regen  : moon run cmd/main -- gen <dir>\n// ---------------------------------------------------------------------------\n\n///|\npub fn A::dummy() -> Unit {\n  ()\n}\n\n///|\npub fn B::dummy() -> Unit {\n  ()\n}\n"
  ))
}

///|
test "幂等：同一输入连续生成两次，输出逐字节相同" {
  let src =
    #|/// @derive(beta, alpha)
    #|struct A { x : Int }
    #|struct B { y : Int }
  let alpha : Rule = {
    name: "alpha",
    description: "",
    gen: fn(td : TypeDef) -> String? { Some("///|\n// alpha " + td.name + "\n") },
  }
  let beta : Rule = {
    name: "beta",
    description: "",
    gen: fn(td : TypeDef) -> String? { Some("///|\n// beta " + td.name + "\n") },
  }
  let rs = rules_of([alpha, beta])
  let a = generate("m.mbt", src, rs, "0.0.0-test")
  let b = generate("m.mbt", src, rs, "0.0.0-test")
  @debug.debug_inspect(a.text == b.text, content=(
    #|true
  ))
  @debug.debug_inspect(a.text.length() > 0, content=(
    #|true
  ))
}

///|
test "诊断：未注册的规则名会产生诊断且不产出内容" {
  let src =
    #|/// @derive(nope)
    #|struct A { x : Int }
  let out = generate("a.mbt", src, [dummy_rule()], "0.0.0-test")
  @debug.debug_inspect(out.has_output, content=(
    #|false
  ))
  @debug.debug_inspect(out.diagnostics.length(), content=(
    #|1
  ))
  @debug.debug_inspect(out.diagnostics[0], content=(
    #|"未知规则 `nope`（由 A 在第 2 行请求）；可用 `moonforge list-rules` 查看"
  ))
}

///|
test "诊断：enum 上请求了只支持 struct 的规则" {
  let src =
    #|/// @derive(dummy)
    #|enum E { A; B }
  let out = generate("e.mbt", src, [dummy_rule()], "0.0.0-test")
  @debug.debug_inspect(out.has_output, content=(
    #|false
  ))
  @debug.debug_inspect(out.diagnostics[0], content=(
    #|"规则 `dummy` 不适用于 E（第 2 行）：该规则只支持 struct 定义"
  ))
}

///|
test "诊断：部分规则可用时仍正常产出，并保留不可用规则的诊断" {
  let src =
    #|/// @derive(dummy, nope)
    #|struct A { x : Int }
  let out = generate("a.mbt", src, [dummy_rule()], "0.0.0-test")
  @debug.debug_inspect(out.has_output, content=(
    #|true
  ))
  @debug.debug_inspect(out.applied, content=(
    #|["A.dummy"]
  ))
  @debug.debug_inspect(out.diagnostics.length(), content=(
    #|1
  ))
}

///|
test "文件命名与筛选约定" {
  @debug.debug_inspect(generated_file_name("models.mbt"), content=(
    #|"models_derive_gen.mbt"
  ))
  @debug.debug_inspect(generated_file_name("a/b/c.mbt"), content=(
    #|"a/b/c_derive_gen.mbt"
  ))
  @debug.debug_inspect(generated_file_name("noext"), content=(
    #|"noext_derive_gen.mbt"
  ))
  @debug.debug_inspect(is_generated_file("models_derive_gen.mbt"), content=(
    #|true
  ))
  @debug.debug_inspect(is_source_file("models.mbt"), content=(
    #|true
  ))
  @debug.debug_inspect(is_source_file("models_derive_gen.mbt"), content=(
    #|false
  ))
  @debug.debug_inspect(is_source_file("notes.md"), content=(
    #|false
  ))
}
