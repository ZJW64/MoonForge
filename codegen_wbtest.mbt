// L3/L4/L5 测试：代码生成。
//
// L4（金样）：固定输入 → 断言输出**逐字节**等于预期文本。
// L5（幂等）：同一输入连续生成两次，结果必须完全相同。
// L3（规则分派）：未知标记、标记不适用、重复标记、迁移提示等错误路径。
//
// 与 0.2 的区别：派生入口从 doc comment 的 `@derive(...)` 换成真实的
// `impl <标记 trait> for <类型>` 声明，因此这里的输入样例全部改写成新写法。

///|
/// 测试用规则：有具名字段时产出一段固定成员文本。
struct DummyRule {}

///|
impl DeriveRule for DummyRule with fn head(_self) -> RuleHead {
  {
    key: "dummy",
    marker: "DeriveDummy",
    trait_name: "Dummy",
    description: "测试用规则",
  }
}

///|
impl DeriveRule for DummyRule with fn generate(_self, td) -> Fragment? {
  if !td.has_named_fields() {
    return None
  }
  Some({ notes: [], impl_body: "fn dummy(_self) -> Unit {\n}\n", })
}

///|
struct BetaRule {}

///|
impl DeriveRule for BetaRule with fn head(_self) -> RuleHead {
  {
    key: "beta",
    marker: "DeriveBeta",
    trait_name: "Beta",
    description: "测试用规则 beta",
  }
}

///|
impl DeriveRule for BetaRule with fn generate(_self, _td) -> Fragment? {
  Some({ notes: [], impl_body: "fn beta(_self) -> Unit {\n}\n", })
}

///|
struct AlphaRule {}

///|
impl DeriveRule for AlphaRule with fn head(_self) -> RuleHead {
  {
    key: "alpha",
    marker: "DeriveAlpha",
    trait_name: "Alpha",
    description: "测试用规则 alpha",
  }
}

///|
impl DeriveRule for AlphaRule with fn generate(_self, _td) -> Fragment? {
  Some({ notes: [], impl_body: "fn alpha(_self) -> Unit {\n}\n", })
}

///|
/// 键名与内置规则同名，用来验证「把规则键误写成标记」时的提示文案。
struct NamesStub {}

///|
impl DeriveRule for NamesStub with fn head(_self) -> RuleHead {
  {
    key: "field_names",
    marker: "DeriveFieldNames",
    trait_name: "FieldNames",
    description: "测试桩：与内置规则同名",
  }
}

///|
impl DeriveRule for NamesStub with fn generate(_self, _td) -> Fragment? {
  Some({
    notes: [],
    impl_body: "fn field_names(_self) -> Array[String] {\n  []\n}\n",
  })
}

///|
fn rules1() -> Array[&DeriveRule] {
  [DummyRule::{ } as &DeriveRule]
}

///|
fn rules2() -> Array[&DeriveRule] {
  [
    AlphaRule::{ } as &DeriveRule,
    BetaRule::{ } as &DeriveRule,
    DummyRule::{ } as &DeriveRule,
  ]
}

///|
/// 把「一行一段」的期望输出拼成带尾换行的文本。
///
/// 用它而不是一整条转义字符串：金样的可读性直接影响它作为文档的价值，
/// 而"每行一段"与生成器的组装方式（逐段拼接）是对应的。
fn text_of(lines : Array[String]) -> String {
  lines.join("\n") + "\n"
}

///|
fn has_text(hay : String, needle : String) -> Bool {
  match hay.find(needle) {
    Some(_) => true
    None => false
  }
}

///|
fn named_type(name : String) -> TypeDef {
  {
    name,
    kind: TStruct,
    body: Record,
    is_pub: false,
    fields: [],
    variants: [],
    doc: "",
    attrs: [],
    line: 1,
  }
}

// ---------------------------------------------------------------------------
// L4 金样
// ---------------------------------------------------------------------------

///|
test "生成：没有任何派生标记时不产出内容（零侵入）" {
  let src =
    #|struct A { x : Int }
    #|fn f() -> Unit { () }
  let out = generate("a.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(out.text, content="\"\"")
  @debug.debug_inspect(out.applied.length(), content="0")
  @debug.debug_inspect(out.diagnostics.length(), content="0")
}

///|
test "生成金样：文件头 + 按 impl 书写顺序逐字节拼接" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveBeta for A with fn requested(_self) {}
    #|
    #|///|
    #|pub impl @d.DeriveAlpha for A with fn requested(_self) {}
  // 注册表里 alpha 在 beta 前面 —— 输出顺序**只**由源码里 impl 的书写顺序决定，
  // 与注册表顺序无关。这条断言把该约定钉住。
  let out = generate("a.mbt", src, rules2(), "0.0.0-test")
  let expected = text_of([
    "// ---------------------------------------------------------------------------",
    "// Generated by MoonForge 0.0.0-test -- DO NOT EDIT.", "// source : a.mbt",
    "// rules  : beta, alpha", "// entry  : impl @derive.DeriveXxx for <Type> with fn requested(_self) {}",
    "// regen  : moon run cmd/main -- gen <dir>", "// ---------------------------------------------------------------------------",
    "", "///|", "pub impl @d.Beta for A with fn beta(_self) -> Unit {", "}", "",
    "///|", "pub impl @d.Alpha for A with fn alpha(_self) -> Unit {", "}",
  ])
  @debug.debug_inspect(out.text == expected, content="true")
  @debug.debug_inspect(out.applied, content="[\"A.beta\", \"A.alpha\"]")
  @debug.debug_inspect(out.diagnostics.length(), content="0")
}

///|
test "生成金样：两个类型、各自独立的标记" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for A with fn requested(_self) {}
    #|
    #|pub struct B {
    #|  y : String
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for B with fn requested(_self) {}
  let out = generate("m.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.applied, content="[\"A.dummy\", \"B.dummy\"]")
  @debug.debug_inspect(
    has_text(out.text, "pub impl @d.Dummy for A with fn dummy(_self) -> Unit {"),
    content="true",
  )
  @debug.debug_inspect(
    has_text(out.text, "pub impl @d.Dummy for B with fn dummy(_self) -> Unit {"),
    content="true",
  )
}

///|
test "render_impl：说明行与 impl 之间留一个空行（moon fmt 稳定性）" {
  // 这段字节形状是硬约束：少了中间的空行，用户跑一次 `moon fmt` 就会让
  // 生成物与生成结果不一致，`moonforge check` 从此永远报漂移且 `gen` 修不好。
  // 端到端的守卫在 `scripts/e2e.sh`（先 fmt 再 check），这里锁住片段形状。
  let decl : ImplDecl = {
    prefix: "@d",
    marker: "DeriveDummy",
    target: "A",
    line: 1,
  }
  let frag : Fragment = {
    notes: ["// moonforge: 跳过 A.i\n"],
    impl_body: "fn f(_self) -> Unit {\n}\n",
  }
  match find_rule(rules1(), "dummy") {
    Some(r) =>
      @debug.debug_inspect(
        render_impl(decl, r, named_type("A"), frag),
        content=(
          #|"// moonforge: 跳过 A.i\n\n///|\npub impl @d.Dummy for A with fn f(_self) -> Unit {\n}\n"
        ),
      )
    None => @debug.debug_inspect("unreachable", content="\"?\"")
  }
}

///|
test "render_impl：没有说明行时不引入多余空行" {
  let decl : ImplDecl = {
    prefix: "@d",
    marker: "DeriveDummy",
    target: "A",
    line: 1,
  }
  let frag : Fragment = { notes: [], impl_body: "fn f(_self) -> Unit {\n}\n", }
  match find_rule(rules1(), "dummy") {
    Some(r) =>
      @debug.debug_inspect(
        render_impl(decl, r, named_type("A"), frag),
        content=(
          #|"///|\npub impl @d.Dummy for A with fn f(_self) -> Unit {\n}\n"
        ),
      )
    None => @debug.debug_inspect("unreachable", content="\"?\"")
  }
}

///|
test "render_impl：复用用户写标记时用的包前缀（不改写别名）" {
  let frag : Fragment = { notes: [], impl_body: "fn f(_self) -> Unit {\n}\n", }
  let td = named_type("A")
  let prefixes : Array[String] = ["@derive", "@d", "@a.b", ""]
  let heads : Array[Bool] = []
  for p in prefixes {
    let decl : ImplDecl = {
      prefix: p,
      marker: "DeriveDummy",
      target: "A",
      line: 1,
    }
    match find_rule(rules1(), "dummy") {
      Some(r) =>
        heads.push(
          has_text(
            render_impl(decl, r, td, frag),
            "for A with fn f(_self) -> Unit {",
          ),
        )
      None => heads.push(false)
    }
  }
  @debug.debug_inspect(heads, content="[true, true, true, true]")
}

// ---------------------------------------------------------------------------
// L5 幂等
// ---------------------------------------------------------------------------

///|
test "幂等：同一输入连续生成两次，输出逐字节相同" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|pub struct B {
    #|  y : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveBeta for A with fn requested(_self) {}
    #|
    #|///|
    #|pub impl @d.DeriveAlpha for A with fn requested(_self) {}
    #|
    #|///|
    #|pub impl @d.DeriveAlpha for B with fn requested(_self) {}
  let a = generate("m.mbt", src, rules2(), "0.0.0-test")
  let b = generate("m.mbt", src, rules2(), "0.0.0-test")
  @debug.debug_inspect(a.text == b.text, content="true")
  @debug.debug_inspect(a.text.length() > 0, content="true")
}

///|
test "幂等：CRLF 源码与 LF 源码生成结果逐字节相同" {
  // Windows 上 core.autocrlf=true 时检出的源码是 CRLF，但生成结果必须是 LF；
  // 如果解析结果依赖换行风格，跨平台就会产出不同字节。
  // 这里用普通字符串字面量（`\r` 会被解释成真正的回车），
  // 不能用 `#|` 原始字符串 —— 原始字符串里的 `\r` 是两个普通字符。
  let lf = "pub struct A {\n  x : String\n}\n\n///|\npub impl @d.DeriveDummy for A with fn requested(_self) {}\n"
  let crlf = "pub struct A {\r\n  x : String\r\n}\r\n\r\n///|\r\npub impl @d.DeriveDummy for A with fn requested(_self) {}\r\n"
  let a = parse(lf)
  let b = parse(crlf)
  @debug.debug_inspect(
    a.types[0].fields[0].ty == b.types[0].fields[0].ty,
    content="true",
  )
  @debug.debug_inspect(a.types[0].fields[0].ty, content="\"String\"")
  @debug.debug_inspect(
    a.impls.length() == 1 && b.impls.length() == 1,
    content="true",
  )
  @debug.debug_inspect(
    generate("a.mbt", lf, rules1(), "0.0.0-test").text ==
    generate("a.mbt", crlf, rules1(), "0.0.0-test").text,
    content="true",
  )
}

// ---------------------------------------------------------------------------
// L3 诊断
// ---------------------------------------------------------------------------

///|
test "诊断：把规则键误写成标记名时，直接指出正确的标记 trait" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.dummy for A with fn requested(_self) {}
  let out = generate("a.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(out.diagnostics.length(), content="1")
  @debug.debug_inspect(
    out.diagnostics[0],
    content=(
      #|"第 6 行：未知的标记 trait `dummy`。已注册的标记 trait：DeriveDummy。注意你写的是**规则键**；派生入口是标记 trait，应为 `DeriveDummy`"
    ),
  )
}

///|
test "诊断：完全不认识的标记名，给出已注册标记清单" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveWhatever for A with fn requested(_self) {}
  let out = generate("a.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.diagnostics.length(), content="1")
  @debug.debug_inspect(
    out.diagnostics[0],
    content="\"第 6 行：未知的标记 trait `DeriveWhatever`。已注册的标记 trait：DeriveDummy。可用 `list-rules` 查看全部规则\"",
  )
}

///|
test "诊断：enum 上打了标记 → 不适用（只支持 struct）" {
  let src =
    #|pub enum E {
    #|  A
    #|  B
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for E with fn requested(_self) {}
  let out = generate("e.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(out.diagnostics.length(), content="1")
  @debug.debug_inspect(
    out.diagnostics[0],
    content=(
      #|"规则 `dummy` 不适用于 E（第 7 行）：该规则只支持 struct 定义"
    ),
  )
}

///|
test "诊断：位置参数结构体给出具体的“不适用”原因" {
  let src =
    #|pub struct P(Int, Int)
    #|
    #|///|
    #|pub impl @d.DeriveDummy for P with fn requested(_self) {}
  let out = generate("p.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(
    out.diagnostics[0],
    content="\"规则 `dummy` 不适用于 P（第 4 行）：P 是位置参数（元组）结构体，没有具名字段\"",
  )
}

///|
test "诊断：没有字段体的声明给出“找不到字段体”而不是误报成 enum" {
  let src =
    #|pub struct O
    #|
    #|pub struct Real {
    #|  a : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for O with fn requested(_self) {}
  let out = generate("o.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(
    out.diagnostics[0],
    content=(
      #|"规则 `dummy` 不适用于 O（第 8 行）：O 的声明里没有找到字段体（既没有 `(` 也没有 `{`）"
    ),
  )
}

///|
test "列宽预算：短类型名不产生提示，长类型名提示会被 fmt 折行" {
  // 82 这条边界是实测值（`scripts/fmt_budget_probe.sh` 用真实 moonfmt 钉住）。
  // 这里不重复算边界算术，只钉两件事：常量本身、以及"过长时确实会提示"。
  @debug.debug_inspect(FMT_WIDTH_BUDGET, content="82")

  // 短类型名：impl 头远在预算内 —— 不能出现任何列宽提示。
  let short = generate(
    "s.mbt",
    "pub struct A {\n  x : Int\n}\n\n///|\npub impl @d.DeriveDummy for A with fn requested(_self) {}\n",
    rules1(),
    "0.0.0-test",
  )
  @debug.debug_inspect(short.diagnostics, content="[]")

  // 长类型名：撑爆预算之后必须说清楚，否则用户只会在 "fmt 之后 check 红了"
  // 与 "gen 治不好" 之间反复横跳，却不知道根因是一行太宽。
  let mut long_name = ""
  for i = 0; i < 40; i = i + 1 {
    long_name = long_name + "T"
  }
  let long = generate(
    "l.mbt",
    "pub struct " +
    long_name +
    " {\n  x : Int\n}\n\n///|\npub impl @d.DeriveDummy for " +
    long_name +
    " with fn requested(_self) {}\n",
    rules1(),
    "0.0.0-test",
  )
  // 仍然产出代码：类型名长不是用户的错，工具不该拒绝干活。
  @debug.debug_inspect(long.has_output, content="true")
  @debug.debug_inspect(long.diagnostics.length(), content="1")
  @debug.debug_inspect(
    has_text(long.diagnostics[0], "超过 `moon fmt` 的列宽预算"),
    content="true",
  )
}

///|
test "诊断：老写法 @derive(...) 给出可粘贴的迁移代码" {
  let src =
    #|/// @derive(field_names)
    #|pub struct A {
    #|  x : Int
    #|}
  let rules : Array[&DeriveRule] = [NamesStub::{ } as &DeriveRule]
  let out = generate("a.mbt", src, rules, "0.0.0-test")
  // 老写法不再产出代码 —— 这正是必须提示的原因：不提示的话，
  // 用户升级后只会看到生成物"莫名消失"。
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(out.diagnostics.length(), content="1")
  @debug.debug_inspect(
    has_text(
      out.diagnostics[0],
      "已废弃的 doc comment 写法 `@derive(field_names)`",
    ),
    content="true",
  )
  @debug.debug_inspect(
    has_text(
      out.diagnostics[0],
      "pub impl @derive.DeriveFieldNames for A with fn requested(_self) {}",
    ),
    content="true",
  )
}

///|
test "诊断：迁移提示里的包前缀沿用文件中已有标记的前缀" {
  let src =
    #|/// @derive(field_names)
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @myalias.DeriveDummy for A with fn requested(_self) {}
  let rules : Array[&DeriveRule] = [
    NamesStub::{ } as &DeriveRule,
    DummyRule::{ } as &DeriveRule,
  ]
  let out = generate("a.mbt", src, rules, "0.0.0-test")
  @debug.debug_inspect(
    has_text(
      out.diagnostics[0],
      "pub impl @myalias.DeriveFieldNames for A with fn requested(_self) {}",
    ),
    content="true",
  )
}

///|
test "诊断：同一条标记写两遍只生成一次，并提示重复" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for A with fn requested(_self) {}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for A with fn requested(_self) {}
  let out = generate("a.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="true")
  @debug.debug_inspect(out.applied, content="[\"A.dummy\"]")
  @debug.debug_inspect(out.diagnostics.length(), content="1")
  @debug.debug_inspect(
    has_text(out.diagnostics[0], "重复的派生声明"),
    content="true",
  )
}

///|
test "诊断：标记指向本文件不存在的类型" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for Ghost with fn requested(_self) {}
  let out = generate("a.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="false")
  @debug.debug_inspect(
    has_text(out.diagnostics[0], "在本文件里没有 struct / enum 定义"),
    content="true",
  )
}

///|
test "诊断：部分标记可用时仍正常产出，并保留不可用标记的诊断" {
  let src =
    #|pub struct A {
    #|  x : Int
    #|}
    #|
    #|///|
    #|pub impl @d.DeriveDummy for A with fn requested(_self) {}
    #|
    #|///|
    #|pub impl @d.DeriveNope for A with fn requested(_self) {}
  let out = generate("a.mbt", src, rules1(), "0.0.0-test")
  @debug.debug_inspect(out.has_output, content="true")
  @debug.debug_inspect(out.applied, content="[\"A.dummy\"]")
  @debug.debug_inspect(out.diagnostics.length(), content="1")
  @debug.debug_inspect(
    has_text(out.diagnostics[0], "DeriveNope"),
    content="true",
  )
}

// ---------------------------------------------------------------------------
// 杂项：文件命名、换行归一、不适用原因
// ---------------------------------------------------------------------------

///|
test "文件命名与筛选约定" {
  @debug.debug_inspect(
    generated_file_name("models.mbt"),
    content="\"models_derive_gen.mbt\"",
  )
  @debug.debug_inspect(
    generated_file_name("a/b/c.mbt"),
    content="\"a/b/c_derive_gen.mbt\"",
  )
  @debug.debug_inspect(
    generated_file_name("noext"),
    content="\"noext_derive_gen.mbt\"",
  )
  @debug.debug_inspect(
    is_generated_file("models_derive_gen.mbt"),
    content="true",
  )
  @debug.debug_inspect(is_source_file("models.mbt"), content="true")
  @debug.debug_inspect(is_source_file("models_derive_gen.mbt"), content="false")
  @debug.debug_inspect(is_source_file("notes.md"), content="false")
}

///|
test "normalize_newlines：CRLF 与单独的 CR 都归一成 LF" {
  @debug.debug_inspect(
    normalize_newlines("a\r\nb\rc\nd\n"),
    content=(
      #|"a\nb\nc\nd\n"
    ),
  )
}

///|
test "normalize_newlines：没有 CR 时原样返回（含空串）" {
  @debug.debug_inspect(normalize_newlines("") == "", content="true")
  @debug.debug_inspect(normalize_newlines("a\nb\n") == "a\nb\n", content="true")
}

///|
test "not_applicable_reason：三种原因各自可辨" {
  let named = parse_source("struct A { x : Int }")[0]
  let positional = parse_source("struct P(Int)")[0]
  let missing = parse_source("struct M")[0]
  let enumerated = parse_source("enum E { A }")[0]
  @debug.debug_inspect(
    not_applicable_reason(positional),
    content="\"P 是位置参数（元组）结构体，没有具名字段\"",
  )
  @debug.debug_inspect(
    not_applicable_reason(missing),
    content="\"M 的声明里没有找到字段体（既没有 `(` 也没有 `{`）\"",
  )
  @debug.debug_inspect(
    not_applicable_reason(enumerated),
    content="\"该规则只支持 struct 定义\"",
  )
  @debug.debug_inspect(
    named.has_named_fields() && !positional.has_named_fields(),
    content="true",
  )
}

///|
test "invalid_rule_name_reason：合法名字返回 None" {
  @debug.debug_inspect(
    invalid_rule_name_reason("field_names") is None,
    content="true",
  )
  @debug.debug_inspect(
    invalid_rule_name_reason("FieldNames") is Some(_),
    content="true",
  )
  @debug.debug_inspect(
    invalid_rule_name_reason("field-names") is Some(_),
    content="true",
  )
}
